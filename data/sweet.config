# sweet configuration file format
dialect = ansi

format {
	quote   = false
	indent  {
		char = space
		size = 4
	}
	newline = lf

	comma = prepend

	compact = no-spaces-arround
	upperize = none
}

lint {
	only-name = {
		severity   = warning
		exclude = name1
	}

	columns-count {
		severity   = warning
		count   = 0 # keep n first issues
		clause  = cte from select
	}

	alias-length {
		severity = warning
		min-length = 1
		max-length = 3
	}
}