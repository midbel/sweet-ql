# sweet configuration file format
dialect = ansi

format {
	rewrite = ansi

	compact = no-spaces-around
	compact = keyword

	upperize = keyword
}

lint {
	no-star = off

	avoid-name {
		level   = warning
		exclude = foo bar
	}

	columns-count {
		level   = warning
		context = *
		context = view
		context = cte
	}
}