# sweet configuration file format
dialect = ansi

format {
	quote   = false
	indent  {
		char = space
		size = 4
	}
	newline = lf

	comma = prepend

	compact = no-spaces-arround
	upperize = none
}

lint {
	no-star = off

	avoid-name {
		level   = warning
		exclude = foo bar
	}

	columns-count {
		level   = warning
		context = *
		context = view
		context = cte
	}
}